---
// Inputs → core → outputs. Paper inputs, a Signal core, Ink outputs that are always links.
// Dashed nodes are optional or a joke.

type Node = { label: string; dashed?: boolean };
type Output = { label: string; href?: string; path?: string; dashed?: boolean };

interface Props {
  caption: string;
  inputs: Node[];
  core: { name: string; notes: string[] };
  outputs: Output[];
}

const { caption, inputs, core, outputs } = Astro.props;
---

<figure class="arch">
  <div class="flow">
    <div class="column">
      <p class="label heading" id="arch-inputs">INPUTS</p>
      <ul role="list" aria-labelledby="arch-inputs">
        {inputs.map((n) => <li class:list={['node', 'input', { dashed: n.dashed }]}>{n.label}</li>)}
      </ul>
    </div>

    <svg class="arrow" viewBox="0 0 56 24" aria-hidden="true">
      <path d="M0 12h50M42 4l8 8-8 8" />
    </svg>

    <div class="core">
      <p class="label heading">CORE</p>
      <p class="core-name">{core.name}</p>
      <ul>
        {core.notes.map((note) => <li>{note}</li>)}
      </ul>
    </div>

    <svg class="arrow" viewBox="0 0 56 24" aria-hidden="true">
      <path d="M0 12h50M42 4l8 8-8 8" />
    </svg>

    <div class="column">
      <p class="label heading" id="arch-outputs">OUTPUTS</p>
      <ul role="list" aria-labelledby="arch-outputs">
        {
          outputs.map((o) =>
            o.href ? (
              <li>
                <a class="node output" href={o.href}>
                  <span class="output-label">{o.label}</span>
                  <span class="label">{o.path ?? o.href} →</span>
                </a>
              </li>
            ) : (
              <li class:list={['node', 'input', { dashed: o.dashed }]}>{o.label}</li>
            ),
          )
        }
      </ul>
    </div>
  </div>
  <figcaption class="label meta">{caption}</figcaption>
</figure>

<style>
  @layer components {
    .arch {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .flow {
      display: grid;
      grid-template-columns: 1fr auto 1.3fr auto 1fr;
      align-items: stretch;
      gap: var(--space-5);
    }

    .column ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: 0;
      list-style: none;
    }

    .heading {
      margin-block-end: var(--space-3);
      font-size: var(--step-tiny);
      font-weight: 700;
    }

    .node {
      display: block;
      padding: var(--space-3) var(--space-4);
      border: var(--rule-mid) solid var(--ink);
    }

    .input {
      background: var(--paper);
      font-family: var(--font-mono);
      font-size: var(--step-small);
    }

    .dashed {
      border-style: dashed;
      border-color: var(--graphite);
      background: transparent;
      color: var(--graphite);
    }

    .output {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-3);
      min-block-size: var(--target);
      background: var(--ink);
      color: var(--paper);
      text-decoration: none;

      &:hover {
        background: var(--signal);
        color: var(--on-signal);
      }
    }

    .output-label {
      font-weight: 700;
    }

    .core {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-5);
      background: var(--signal);
      color: var(--on-signal);
      border: var(--rule-heavy) solid var(--ink);

      & .heading {
        margin: 0;
      }

      & ul {
        padding-inline-start: 1.1em;
        font-size: var(--step-small);
        line-height: 1.5;
      }
    }

    .core-name {
      font-size: 2rem;
      line-height: 1;
      font-weight: 900;
      font-stretch: 125%;
    }

    .arrow {
      inline-size: 56px;
      align-self: center;
      fill: none;
      stroke: var(--ink);
      stroke-width: 2.5;
    }

    /* Narrow screens: the flow runs top to bottom and the arrows turn to point down. */
    @media (width < 60rem) {
      .flow {
        grid-template-columns: 1fr;
        gap: var(--space-3);
      }

      .arrow {
        justify-self: center;
        rotate: 90deg;
        inline-size: 40px;
        margin-block: var(--space-3); /* rotation doesn't reserve the extra height */
      }
    }
  }
</style>
