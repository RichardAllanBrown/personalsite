---
// Top of every section index: mono path label, display title, one short intro paragraph.
interface Props {
  title: string;
  label: string;
}

const { title, label } = Astro.props;
---

<header class="wrap page-head">
  <p class="label meta">{label}</p>
  <h1>{title}</h1>
  {Astro.slots.has('default') && (
    <p class="measure">
      <slot />
    </p>
  )}
</header>

<style>
  @layer components {
    .page-head {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding-block: var(--space-8) var(--space-7);
    }
  }
</style>
